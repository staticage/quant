      "enableRateLimit": true,
      "options": {
        "fetchMarkets": {
          "types": [
            "spot"
          ]
        }
      },
      "urls": {
        "api": {
          "public": "https://data-api.binance.vision/api/v3"
        }
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "fetchMarkets": {
          "types": [
            "spot"
          ]
        }
      },
